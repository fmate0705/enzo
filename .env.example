# Public base URL, used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://enzodinapoli.hu

# ---------------------------------------------------------------------------
# Admin
#
# Generate the hash and the secret with:
#   pnpm run admin:credentials "a strong passphrase"
#
# The plaintext password is never stored anywhere — only the scrypt hash below.
# Rotating AUTH_SECRET signs every open session out immediately.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Content store
#
# Where admin edits are written. In Docker this MUST point at a mounted volume,
# or every edit is lost when the container is replaced. See deploy/DEPLOY.md.
# ---------------------------------------------------------------------------
CONTENT_DATA_DIR=/data
